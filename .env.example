# Whop API Configuration
# Get these from https://whop.com/dashboard/developer
WHOP_API_KEY=your_api_key_here
WHOP_APP_ID=app_xxxxxxxxxxxxxx
WHOP_COMPANY_ID=biz_xxxxxxxxxxxxxx

# Application Settings
NODE_ENV=development
LOG_LEVEL=debug

# Clipper Program Settings
DEFAULT_CPM_RATE=20.0
MIN_PAYOUT_THRESHOLD=2
MAX_PAYOUT_CAP=100
AUTO_APPROVE_HOURS=48
CAMPAIGN_BUDGET=200

# Source Content
TWITCH_SOURCE=https://www.twitch.tv/your_channel
